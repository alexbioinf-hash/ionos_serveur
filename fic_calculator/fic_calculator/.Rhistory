row.names = FALSE),
error = function(e) warning("Failed to save TableS1: ", e$message)
)
if (!is.null(pairwise_tests())) {
tryCatch(
write.csv(pairwise_tests() %>% dplyr::arrange(p_adj) %>%
dplyr::mutate(across(where(is.numeric), ~round(., 5))),
