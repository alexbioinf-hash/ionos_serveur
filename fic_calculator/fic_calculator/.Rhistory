.render_article(word_file, rmarkdown::word_document(toc = TRUE, reference_docx = NULL))
}, error = function(e) warning("Failed to generate Word report: ", e$message))
shiny::setProgress(0.65, detail = "Saving manuscript text...")
tryCatch(
writeLines(manuscript_text_r(),
