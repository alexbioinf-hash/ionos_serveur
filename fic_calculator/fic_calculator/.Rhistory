error = function(e) warning("Failed to save manuscript: ", e$message)
)
shiny::setProgress(0.75, detail = "Saving analysis bundle...")
tryCatch({
bundle <- list(
metadata = list(date = Sys.time(), app_version = "1.0",
n_pipelines = nrow(pipeline_stats()), n_iterations = nrow(df())),
pipeline_stats = pipeline_stats(), pairwise_tests = pairwise_tests(),
kruskal_test = kruskal_result(), top5_centroids = top5_centroids(),
top5_table = if (!is.null(top5_table)) top5_table else NULL,
figures = list(fig1 = fig1(), fig2 = fig2(), fig3 = fig3(), fig4 = fig4()),
raw_data = df()
)
saveRDS(bundle, file.path(tmp, "Analysis_Bundle.rds"))
}, error = function(e) warning("Failed to save bundle: ", e$message))
shiny::setProgress(0.85, detail = "Writing README...")
kt <- kruskal_result()
best <- pipeline_stats()[1, ]
readme <- paste0(
"MSclassifR Analysis Results — Complete Export Package\n",
