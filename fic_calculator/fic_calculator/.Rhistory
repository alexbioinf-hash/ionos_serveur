row.names = FALSE),
error = function(e) warning("Failed to save TableS2: ", e$message)
)
}
st5 <- pipeline_stats() %>% dplyr::slice_head(n = 5)
top5_table <- tryCatch({
do.call(rbind, lapply(seq_len(nrow(st5)), function(i) {
row <- st5[i, ]
cen <- top5_centroids()[[i]]
ci  <- boot_ci_median(
df() %>% dplyr::filter(Model == row$Model, SelectVarMethod == row$SelectVarMethod,
SamplingMethod == row$SamplingMethod) %>% dplyr::pull(Val_Kappa)
)
data.frame(Rank = i, Model = row$Model, SelectVarMethod = row$SelectVarMethod,
SamplingMethod = row$SamplingMethod, Composite_Score = row$Score,
Median_Val_Kappa = round(row$Median_VK, 4), CI95_Lo = round(ci["lo"], 4),
CI95_Hi = round(ci["hi"], 4), SD_Val_Kappa = round(row$SD_VK, 4),
IQR_Val_Kappa = round(row$IQR_VK, 4), Median_Gap_Train_Val = round(row$Median_Gap, 4),
Median_NbVars = round(row$Median_Vars, 1), N_iterations = row$N,
Deploy_NbRepeatSampling = cen$NbRepeatSampling, Deploy_NbRepeatSubset = cen$NbRepeatSubset,
Deploy_Val_Kappa = round(cen$Val_Kappa, 4), Deploy_NbSelectedVars = cen$NbSelectedVariables,
row.names = NULL, stringsAsFactors = FALSE)
}))
}, error = function(e) { warning("Failed to build top5_table: ", e$message); NULL })
if (!is.null(top5_table)) {
tryCatch(write.csv(top5_table,
file.path(tmp, "Supplemental_Tables", "TableS3_Top5_deployment_cards.csv"),
row.names = FALSE),
error = function(e) warning("Failed to save TableS3: ", e$message))
}
tryCatch(
write.csv(df() %>% dplyr::mutate(across(where(is.numeric), ~round(., 5))),
