}
print(prs, target = file.path(tmp, "Figures_PPTX", "All_Figures.pptx"))
}, error = function(e) warning("Failed to create PPTX: ", e$message))
shiny::setProgress(0.35, detail = "Saving supplemental tables...")
tryCatch(
write.csv(pipeline_stats() %>% dplyr::mutate(across(where(is.numeric), ~round(., 4))),
