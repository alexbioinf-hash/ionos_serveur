.render_article(html_file, rmarkdown::html_document(
self_contained = TRUE, toc = TRUE, toc_float = TRUE,
theme = "cosmo", df_print = "paged", highlight = "pygments"))
}, error = function(e) warning("Failed to generate HTML report: ", e$message))
tryCatch({
