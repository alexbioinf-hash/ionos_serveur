output$dl_all <- shiny::downloadHandler(
filename = function() {
paste0("MSclassifR_Analysis_", format(Sys.Date(), "%Y-%m-%d"), ".zip")
},
content = function(file) {
shiny::req(fig1(), fig2(), fig3(), fig4(), pipeline_stats(), top5_centroids(),
kruskal_result(), df(), pairwise_tests())
shiny::withProgress(message = "Generating export package...", value = 0, {
tmp <- tempfile(pattern = "msc_export_")
dir.create(tmp)
dir.create(file.path(tmp, "Figures_TIFF"))
dir.create(file.path(tmp, "Figures_PPTX"))
dir.create(file.path(tmp, "Reports"))
dir.create(file.path(tmp, "Supplemental_Tables"))
dir.create(file.path(tmp, "Manuscript"))
on.exit(unlink(tmp, recursive = TRUE), add = TRUE)
shiny::setProgress(0.05, detail = "Saving Figure 1 (TIFF)...")
tryCatch(
ggplot2::ggsave(file.path(tmp, "Figures_TIFF", "Figure_1_Benchmark_overview.tiff"),
plot = fig1(), device = "tiff", width = 12, height = 8,
units = "in", dpi = 300, compression = "lzw"),
error = function(e) warning("Failed to save Figure 1 TIFF: ", e$message)
)
shiny::setProgress(0.10, detail = "Saving Figure 2 (TIFF)...")
tryCatch(
ggplot2::ggsave(file.path(tmp, "Figures_TIFF", "Figure_2_MultiObjective_ranking.tiff"),
plot = fig2(), device = "tiff", width = 10, height = 9,
units = "in", dpi = 300, compression = "lzw"),
error = function(e) warning("Failed to save Figure 2 TIFF: ", e$message)
)
shiny::setProgress(0.15, detail = "Saving Figure 3 (TIFF)...")
tryCatch(
ggplot2::ggsave(file.path(tmp, "Figures_TIFF", "Figure_3_Statistical_analysis.tiff"),
